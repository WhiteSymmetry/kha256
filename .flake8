[flake8]
max-line-length = 120
max-complexity = 10
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .venv,
    venv

# Yorumları ayrı satıra yazın, ignore satırının içine DEĞİL
# E203: whitespace before ':'
# W503: line break before binary operator  
# E501: line too long
ignore = E203, W503, E501
